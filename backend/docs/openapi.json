{
  "openapi": "3.1.0",
  "info": {
    "title": "Abstrabit Enterprise RAG & Tool Calling API",
    "version": "1.0.0",
    "description": "Enterprise Multi-Workspace Document Assistant API providing tenant-isolated vector search (pgvector), grounded RAG chat with inline citations, and schema-validated tool calling."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponseSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object" },
          "requestId": { "type": "string", "example": "123e4567-e89b-12d3-a456-426614174000" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "ApiResponseError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "UNAUTHORIZED" },
              "message": { "type": "string", "example": "Invalid or expired authentication token" }
            }
          },
          "requestId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness Health Check",
        "responses": {
          "200": { "description": "Server is live" }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness Database Connectivity Check",
        "responses": {
          "200": { "description": "Database connected" },
          "503": { "description": "Database connection unavailable" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "first_name": { "type": "string" },
                  "last_name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT token pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/documents/upload": {
      "post": {
        "summary": "Upload and ingest document into active workspace",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "document": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Document ingested successfully" },
          "200": { "description": "Identical document already exists (Idempotent match)" },
          "400": { "description": "Unsupported file format or max file size exceeded" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/chat": {
      "post": {
        "summary": "Execute grounded RAG chat completion and optional tool execution",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string" },
                  "includeDebug": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Grounded answer generated with inline citations" },
          "403": { "description": "Workspace access forbidden" }
        }
      }
    }
  }
}

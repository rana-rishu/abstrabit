# Backend Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/abstrabit

# JWT Authentication Secrets (min 32 characters)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_32chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API Key (Free Tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:5000

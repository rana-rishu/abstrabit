# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multi_workspace_rag

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_token_key_min_32_chars_long_enterprise
JWT_REFRESH_SECRET=super_secret_refresh_token_key_min_32_chars_long_enterprise
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API (Free Tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
